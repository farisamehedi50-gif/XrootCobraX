                c3 = new THREE.Color(0xb829ff),
                c4 = new THREE.Color(0xffd700);
            for (let i = 0; i < count * 3; i += 3) {
                const r = 7.5 * Math.cbrt(Math.random());
                const th = Math.random() * Math.PI * 2;
                const ph = Math.acos(2 * Math.random() - 1);
                pos[i] = Math.sin(ph) * Math.cos(th) * r;
                pos[i + 1] = Math.sin(ph) * Math.sin(th) * r * 0.6;
                pos[i + 2] = Math.cos(ph) * r * 0.7;
                const mix = Math.random();
                let c;
                if (mix < 0.35) c = c1.clone().lerp(c3, Math.random());
                else if (mix < 0.65) c = c2.clone().lerp(c4, Math.random());
                else c = c3.clone().lerp(c1, Math.random());
                col[i] = c.r; col[i + 1] = c.g; col[i + 2] = c.b;
            }
            geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
            geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
