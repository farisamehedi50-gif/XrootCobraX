        const startT = Date.now();
        setInterval(() => {
            const diff = Math.floor((Date.now() - startT) / 1000);
            document.getElementById('trackUptime').textContent = String(Math.floor(diff / 60)).padStart(2, '0') + ':' + String(diff % 60).padStart(2, '0');
        }, 1000);

        // ============ VISITORS ============
        let v = parseInt(localStorage.getItem('bhx_visits2') || 0) + 1;
        localStorage.setItem('bhx_visits2', v);
        document.getElementById('trackVisits').textContent = v;

        // ============ TRACKING ============
        async function fetchTrack() {
            try {
                const r = await fetch('https://ipapi.co/json/');
                const d = await r.json();
                document.getElementById('trackIP').textContent = d.ip || '--';
                document.getElementById('trackLoc').textContent = (d.city || '?') + ', ' + (d.country_name || '?');
                document.getElementById('trackISP').textContent = d.org || d.isp || '--';
            } catch (e) {
                document.getElementById('trackIP').textContent = 'SECURED';
                document.getElementById('trackLoc').textContent = 'HIDDEN';
                document.getElementById('trackISP').textContent = 'ENCRYPTED';
            }
            document.getElementById('trackBrowser').textContent = navigator.userAgent.includes('Mobile') ? 'MOBILE' : 'DESKTOP';
        }
        fetchTrack();

        // ============ AUTO LOGS ============
        setInterval(() => {
            const msgs = ['ℹ Firewall check passed', '✓ System healthy', 'ℹ Monitoring traffic', '✓ Encryption active', 'ℹ IPS online'];
            addLog(msgs[Math.floor(Math.random() * msgs.length)], Math.random() > 0.3 ? 'info' : 'success');
        }, 7000);

        // ============ AUDIO ============
        function startAudio() {
            const m = document.getElementById('bg-music');
            if (m && m.paused) m.play().catch(() => {});
        }
        document.body.addEventListener('click', startAudio, { once: false });
        document.body.addEventListener('touchstart', startAudio, { once: false });

        console.log('%c⚡ MehediSaniX | Cyber Security BD ⚡', 'color:#00d4ff;font-size:22px;');
        console.log('%c🇧🇩 হ্যাকিং কোন অপরাধ নয়, হ্যাকিং একটি শিল্প 🇧🇩', 'color:#ff2d55;font-size:14px;');
    </script>
</body>
