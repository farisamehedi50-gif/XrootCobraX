        function spark(x, y) {
            lctx.clearRect(0, 0, lc.width, lc.height);
            for (let j = 0; j < 10; j++) {
                lctx.beginPath();
                const colors = ['#00d4ff', '#ff2d95', '#b829ff', '#ffd700', '#00ff88'];
                lctx.strokeStyle = colors[j % colors.length];
                lctx.lineWidth = Math.random() * 2.5 + 1;
                lctx.shadowBlur = 18;
                lctx.shadowColor = lctx.strokeStyle;
                let cx = x, cy = y;
                lctx.moveTo(cx, cy);
                for (let i = 0; i < 12; i++) {
                    cx += (Math.random() - 0.5) * 50;
                    cy += (Math.random() - 0.5) * 50;
                    lctx.lineTo(cx, cy);
                }
