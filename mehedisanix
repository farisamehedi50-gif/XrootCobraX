                });
                ctx.strokeStyle = 'rgba(0,255,136,0.7)';
                ctx.lineWidth = 3;
                ctx.shadowBlur = 25;
                ctx.shadowColor = '#00ff88';
                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.lineTo(cx + Math.cos(angle) * radius, cy + Math.sin(angle) * radius);
